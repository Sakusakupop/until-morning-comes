root = true

# すべてのファイルに対する基本設定
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# ソースコード固有の設定
[*.cs]

# インデントと改行
indent_size = 4
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current

# Allman スタイルとブレース
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_preserve_single_line_statements = false
csharp_prefer_braces = true:warning
csharp_preferred_modifier_order = public, private, protected, internal, static, extern, new, virtual, abstract, sealed, override, readonly, unsafe, async

# using の整理
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:silent

# このプロジェクトでは var を基本にする
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# 読みやすさと Unity の対応バージョン
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
csharp_style_namespace_declarations = block_scoped:suggestion

# 演算子や区切り記号の前後の空白
csharp_space_after_cast = false
csharp_space_after_comma = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_around_binary_operators = before_and_after
csharp_space_before_comma = false

# 命名規則: クラス・構造体・列挙型・デリゲート・namespace は PascalCase
dotnet_naming_rule.types_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.types_should_be_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate, namespace

# 命名規則: インターフェースは I + PascalCase
dotnet_naming_rule.interfaces_should_start_with_i.severity = suggestion
dotnet_naming_rule.interfaces_should_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_should_start_with_i.style = interface_style

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface

dotnet_naming_style.interface_style.required_prefix = I
dotnet_naming_style.interface_style.capitalization = pascal_case

# 命名規則: メソッドとローカル関数は PascalCase
dotnet_naming_rule.methods_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.methods_should_be_pascal_case.symbols = method_symbols
dotnet_naming_rule.methods_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.method_symbols.applicable_kinds = method, local_function
dotnet_naming_symbols.method_symbols.applicable_accessibilities = *

# 命名規則: プロパティとイベントは PascalCase
dotnet_naming_rule.properties_and_events_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.properties_and_events_should_be_pascal_case.symbols = property_event_symbols
dotnet_naming_rule.properties_and_events_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.property_event_symbols.applicable_kinds = property, event
dotnet_naming_symbols.property_event_symbols.applicable_accessibilities = *

# 命名規則: 公開フィールドは PascalCase
dotnet_naming_rule.public_fields_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.public_fields_should_be_pascal_case.symbols = public_field_symbols
dotnet_naming_rule.public_fields_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.public_field_symbols.applicable_kinds = field
dotnet_naming_symbols.public_field_symbols.applicable_accessibilities = public, protected, protected_internal

# 命名規則: フィールド・ローカル変数・引数は camelCase（公開フィールドと定数は上の規則を優先）
dotnet_naming_rule.variables_should_be_camel_case.severity = suggestion
dotnet_naming_rule.variables_should_be_camel_case.symbols = variable_symbols
dotnet_naming_rule.variables_should_be_camel_case.style = camel_case_style

dotnet_naming_symbols.variable_symbols.applicable_kinds = field, local, parameter
dotnet_naming_symbols.variable_symbols.applicable_accessibilities = *

# 定数名はアクセス範囲にかかわらず PascalCase
dotnet_naming_rule.constants_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.constants_should_be_pascal_case.symbols = constant_symbols
dotnet_naming_rule.constants_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.constant_symbols.applicable_kinds = field
dotnet_naming_symbols.constant_symbols.required_modifiers = const

# ジェネリック型パラメーターは T + PascalCase
dotnet_naming_rule.type_parameters_should_start_with_t.severity = suggestion
dotnet_naming_rule.type_parameters_should_start_with_t.symbols = type_parameter_symbols
dotnet_naming_rule.type_parameters_should_start_with_t.style = type_parameter_style

dotnet_naming_symbols.type_parameter_symbols.applicable_kinds = type_parameter

dotnet_naming_style.type_parameter_style.required_prefix = T
dotnet_naming_style.type_parameter_style.capitalization = pascal_case

# 共通の命名スタイル
dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_style.camel_case_style.capitalization = camel_case
